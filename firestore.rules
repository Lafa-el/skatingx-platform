rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/skatingx-production/users/{userId} {

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // --- unchanged behavior --------------------------------------------------------
      // The user document itself, as before (rules_version 2: `**` matches zero segments).
      allow read, write: if isOwner();

      // Every collection EXCEPT raceDay, analyses, and athletes: same owner-only access as
      // the previous `{document=**}` rule. Those are excluded here because Firestore ORs
      // matching `allow` rules, so a broad rule would make their validation ineffective.
      match /{collection}/{path=**} {
        allow read, write: if isOwner()
          && collection != 'raceDay'
          && collection != 'analyses'
          && collection != 'athletes';
      }

      // Athlete documents stay owner-writable. equipment/main/records/{id} is not included:
      // only the lindsay path below may write that document, and only in the contract shape.
      match /athletes/{athleteId} {
        allow read, write: if isOwner();
      }

      // Fixed depths, not a recursive wildcard: a path value has no matches() or size().
      // Four segments under the athlete is where equipment/main/records/{id} lives, so that
      // one shape is left to the validated match. Every other current athlete path stays
      // owner-writable (profile, gamification, training, the unused 9-segment equipment helper).
      match /athletes/{athleteId}/{a} {
        allow read, write: if isOwner();
      }

      match /athletes/{athleteId}/{a}/{b} {
        allow read, write: if isOwner();
      }

      match /athletes/{athleteId}/{a}/{b}/{c} {
        allow read, write: if isOwner();
      }

      match /athletes/{athleteId}/{a}/{b}/{c}/{d} {
        allow read, write: if isOwner() && !(a == 'equipment' && b == 'main' && c == 'records');
      }

      match /athletes/{athleteId}/{a}/{b}/{c}/{d}/{e} {
        allow read, write: if isOwner();
      }

      match /athletes/{athleteId}/{a}/{b}/{c}/{d}/{e}/{f} {
        allow read, write: if isOwner();
      }

      // --- raceDay: owner-only AND validated (ADR-001 D6, D8) -------------------------
      // Unknown subcollections under raceDay match nothing and are denied.

      function validId(id) {
        return id.size() <= 64 && id.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
      }

      // Pending data can never carry a verification time, verified data must (ADR-001 D5).
      function validProvenance(d) {
        return d.verification in ['pending', 'verified']
          && d.source == 'manual'
          && d.sourceNote is string && d.sourceNote.size() <= 500
          && (d.verification == 'pending'
                ? d.verifiedAt == null
                : d.verifiedAt is timestamp);
      }

      function validAudit(d) {
        return d.schemaVersion == 1
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
      }

      function createdAtUnchanged() {
        return request.resource.data.createdAt == resource.data.createdAt;
      }

      function exactKeys(d, keys) {
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys);
      }

      function validEvent(id, d) {
        return exactKeys(d, ['eventId', 'name', 'dates', 'timeZone', 'venue',
                             'verification', 'source', 'sourceNote', 'verifiedAt',
                             'schemaVersion', 'createdAt', 'updatedAt'])
          && validProvenance(d) && validAudit(d)
          && validId(id) && d.eventId == id
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
          && d.dates is list && d.dates.size() >= 1 && d.dates.size() <= 10
          && (d.timeZone == null || (d.timeZone is string && d.timeZone.size() <= 64))
          && (d.venue == null || (d.venue is string && d.venue.size() <= 200));
      }

      function validRosterEntry(id, d) {
        return exactKeys(d, ['rosterId', 'displayName', 'bib', 'division', 'isSelf',
                             'isFollowed', 'athleteRefId',
                             'verification', 'source', 'sourceNote', 'verifiedAt',
                             'schemaVersion', 'createdAt', 'updatedAt'])
          && validProvenance(d) && validAudit(d)
          && validId(id) && d.rosterId == id
          && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 120
          && d.bib is string && d.bib.size() >= 1 && d.bib.size() <= 16
          && d.division is string && d.division.size() >= 1 && d.division.size() <= 80
          && d.isSelf is bool && d.isFollowed is bool
          && (d.athleteRefId == null || (d.athleteRefId is string && d.athleteRefId.size() <= 64));
      }

      function validRace(id, d) {
        return exactKeys(d, ['raceId', 'distanceId', 'label', 'sortOrder', 'day', 'round',
                             'heat', 'scheduledAt', 'rosterIds',
                             'verification', 'source', 'sourceNote', 'verifiedAt',
                             'schemaVersion', 'createdAt', 'updatedAt'])
          && validProvenance(d) && validAudit(d)
          && validId(id) && d.raceId == id
          && d.distanceId is string && d.distanceId.size() >= 1 && d.distanceId.size() <= 32
          && d.label is string && d.label.size() >= 1 && d.label.size() <= 80
          && d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 999
          && (d.day == null || (d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (d.round == null || (d.round is string && d.round.size() <= 40))
          && (d.heat == null || (d.heat is string && d.heat.size() <= 40))
          && (d.scheduledAt == null || d.scheduledAt is timestamp)
          && d.rosterIds is list && d.rosterIds.size() <= 50;
      }

      // Mirrors validateRaceResultInput in packages/skating-domain: a finished race needs
      // a time; DNS/DNF/DQ carry no time, no place and cannot be marked as advanced.
      function validResult(id, d) {
        return exactKeys(d, ['resultId', 'raceId', 'rosterId', 'status', 'timeSeconds',
                             'place', 'advanced',
                             'verification', 'source', 'sourceNote', 'verifiedAt',
                             'schemaVersion', 'createdAt', 'updatedAt'])
          && validProvenance(d) && validAudit(d)
          && d.raceId is string && validId(d.raceId)
          && d.rosterId is string && validId(d.rosterId)
          && d.resultId == id && id == d.raceId + '_' + d.rosterId
          && d.status in ['finished', 'DNS', 'DNF', 'DQ']
          && (d.place == null || (d.place is int && d.place >= 1))
          && (d.advanced == null || d.advanced is bool)
          && (d.status == 'finished'
                ? (d.timeSeconds is number && d.timeSeconds > 0 && d.timeSeconds <= 1800)
                : (d.timeSeconds == null && d.place == null && d.advanced != true));
      }

      // Video METADATA only (ADR-001 D4): fixed keys, no file or media fields can be stored.
      function validVideo(id, d) {
        return exactKeys(d, ['videoId', 'raceId', 'rosterId', 'label', 'externalUrl',
                             'storedWhere', 'note',
                             'schemaVersion', 'createdAt', 'updatedAt'])
          && validAudit(d)
          && validId(id) && d.videoId == id
          && d.raceId is string && validId(d.raceId)
          && d.rosterId is string && validId(d.rosterId)
          && d.label is string && d.label.size() >= 1 && d.label.size() <= 120
          && (d.externalUrl == null
                || (d.externalUrl is string && d.externalUrl.size() <= 2048
                    && d.externalUrl.matches('^https?://.+')))
          && (d.storedWhere == null || (d.storedWhere is string && d.storedWhere.size() <= 200))
          && (d.note == null || (d.note is string && d.note.size() <= 1000));
      }

      function validSummary(d) {
        return exactKeys(d, ['summaryVersion', 'generatedAt', 'coachNote',
                             'schemaVersion', 'createdAt', 'updatedAt'])
          && validAudit(d)
          && d.summaryVersion is string && d.summaryVersion.size() <= 40
          && (d.generatedAt == null || d.generatedAt is timestamp)
          && (d.coachNote == null || (d.coachNote is string && d.coachNote.size() <= 2000));
      }

      match /raceDay/{eventId} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && validEvent(eventId, request.resource.data);
        allow update: if isOwner() && validEvent(eventId, request.resource.data)
                      && createdAtUnchanged();

        match /roster/{rosterId} {
          allow read, delete: if isOwner();
          allow create: if isOwner() && validRosterEntry(rosterId, request.resource.data);
          allow update: if isOwner() && validRosterEntry(rosterId, request.resource.data)
                        && createdAtUnchanged();
        }

        match /races/{raceId} {
          allow read, delete: if isOwner();
          allow create: if isOwner() && validRace(raceId, request.resource.data);
          allow update: if isOwner() && validRace(raceId, request.resource.data)
                        && createdAtUnchanged();
        }

        match /results/{resultId} {
          allow read, delete: if isOwner();
          allow create: if isOwner() && validResult(resultId, request.resource.data);
          allow update: if isOwner() && validResult(resultId, request.resource.data)
                        && createdAtUnchanged();
        }

        match /videos/{videoId} {
          allow read, delete: if isOwner();
          allow create: if isOwner() && validVideo(videoId, request.resource.data);
          allow update: if isOwner() && validVideo(videoId, request.resource.data)
                        && createdAtUnchanged();
        }

        match /summaries/{summaryId} {
          allow read, delete: if isOwner() && summaryId == 'main';
          allow create: if isOwner() && summaryId == 'main' && validSummary(request.resource.data);
          allow update: if isOwner() && summaryId == 'main' && validSummary(request.resource.data)
                        && createdAtUnchanged();
        }
      }

      // analyses/{analysisId}: user-level, 6 segments (ADR-005 §1).
      // Field checks follow AnalysisRecord in docs/migration/analysis/contract-types.ts.
      // createdAt is an ISO-8601 string from Date.toISOString(), not a Timestamp.
      // athleteId is lindsay for this port.
      // A pace document and a biomechanics document are two exact key sets. Pose frames
      // are a list of at most 10 (the on-page sample cap). Each item is checked for
      // timeSeconds and readable only. Landmark maps are not unrolled: 10 frames times
      // 33 points exceeds the rules engine's 1000-expression cap.
      function validPoseModel(m) {
        return m is map
          && exactKeys(m, ['modelVersion', 'modelVariant', 'modelComplexity',
                           'smoothLandmarks', 'enableSegmentation',
                           'minDetectionConfidence', 'minTrackingConfidence',
                           'poseFrameIntervalMs', 'maxAnalysisEdgePx'])
          && m.modelVersion == 'mediapipe-pose@0.5.1675469404'
          && m.modelVariant == 'pose_landmark_full'
          && m.modelComplexity == 1
          && m.smoothLandmarks == true
          && m.enableSegmentation == false
          && m.minDetectionConfidence == 0.5
          && m.minTrackingConfidence == 0.5
          && m.poseFrameIntervalMs == 180
          && m.maxAnalysisEdgePx == 640;
      }

      function validAnalysisProvenance(p) {
        return p is map
          && exactKeys(p, ['schemaVersion', 'algorithmVersion', 'model'])
          && p.schemaVersion == 'skatingx-analysis-contract-v1'
          && p.algorithmVersion is string
          && p.algorithmVersion.size() > 0
          && p.algorithmVersion.size() <= 80
          && validPoseModel(p.model);
      }

      function validFinding(item, id) {
        return item is map
          && exactKeys(item, ['code', 'analysisId'])
          && item.analysisId == id
          && item.code in [
            'pace.decay.back-half', 'pace.total.versus-benchmark',
            'biomech.knee.high', 'biomech.lean.high', 'biomech.pelvis.high',
            'biomech.frame.unreadable',
            'equipment.symptom.slide', 'equipment.symptom.boot-out',
            'equipment.symptom.unstable', 'equipment.symptom.ankle',
            'equipment.symptom.release', 'equipment.symptom.asymmetry'
          ];
      }

      // Rules have no loop. Eight is above the two findings this slice writes.
      function validFindings(items, id) {
        return items is list
          && items.size() <= 8
          && (items.size() < 1 || validFinding(items[0], id))
          && (items.size() < 2 || validFinding(items[1], id))
          && (items.size() < 3 || validFinding(items[2], id))
          && (items.size() < 4 || validFinding(items[3], id))
          && (items.size() < 5 || validFinding(items[4], id))
          && (items.size() < 6 || validFinding(items[5], id))
          && (items.size() < 7 || validFinding(items[6], id))
          && (items.size() < 8 || validFinding(items[7], id));
      }

      function validPaceOutput(pace, id) {
        return pace is map
          && exactKeys(pace, ['provenance', 'totalSeconds', 'benchmarkTotalSeconds',
                              'stabilityIndexPercent', 'rating', 'trainingEmphasisRatio',
                              'findings'])
          && validAnalysisProvenance(pace.provenance)
          && pace.totalSeconds is number
          && pace.benchmarkTotalSeconds is number
          && pace.stabilityIndexPercent is int
          && pace.stabilityIndexPercent >= 0
          && pace.stabilityIndexPercent <= 100
          && pace.rating in ['excellent', 'needs-work', 'moderate']
          && pace.trainingEmphasisRatio is string
          && pace.trainingEmphasisRatio.size() > 0
          && pace.trainingEmphasisRatio.size() <= 16
          && validFindings(pace.findings, id);
      }

      function validIsoCreatedAt(value) {
        return value is string
          && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
      }

      function validPaceAnalysisRecord(id, d) {
        return validId(id)
          && exactKeys(d, ['id', 'ownerUserId', 'athleteId', 'createdAt',
                           'provenance', 'findings', 'pace'])
          && d.id == id
          && d.ownerUserId == userId
          && d.athleteId == 'lindsay'
          && validIsoCreatedAt(d.createdAt)
          && validAnalysisProvenance(d.provenance)
          && validFindings(d.findings, id)
          && validPaceOutput(d.pace, id);
      }

      // 10 is MAX_POSE_KEYFRAMES. One predicate per index, not per landmark.
      function validPoseFrame(item) {
        return item is map
          && item.timeSeconds is number
          && item.timeSeconds >= 0
          && item.timeSeconds <= 86400
          && item.readable is bool;
      }

      function validPoseFrames(items) {
        return items is list
          && items.size() <= 10
          && (items.size() < 1 || validPoseFrame(items[0]))
          && (items.size() < 2 || validPoseFrame(items[1]))
          && (items.size() < 3 || validPoseFrame(items[2]))
          && (items.size() < 4 || validPoseFrame(items[3]))
          && (items.size() < 5 || validPoseFrame(items[4]))
          && (items.size() < 6 || validPoseFrame(items[5]))
          && (items.size() < 7 || validPoseFrame(items[6]))
          && (items.size() < 8 || validPoseFrame(items[7]))
          && (items.size() < 9 || validPoseFrame(items[8]))
          && (items.size() < 10 || validPoseFrame(items[9]));
      }

      function validBiomechAnalysisRecord(id, d) {
        return validId(id)
          && exactKeys(d, ['id', 'ownerUserId', 'athleteId', 'createdAt',
                           'provenance', 'findings', 'poseFrames'])
          && d.id == id
          && d.ownerUserId == userId
          && d.athleteId == 'lindsay'
          && validIsoCreatedAt(d.createdAt)
          && validAnalysisProvenance(d.provenance)
          && d.provenance.algorithmVersion == 'legacy-biomech-port-1'
          && validFindings(d.findings, id)
          && validPoseFrames(d.poseFrames);
      }

      function validAnalysisRecord(id, d) {
        return validPaceAnalysisRecord(id, d) || validBiomechAnalysisRecord(id, d);
      }

      match /analyses/{analysisId} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && validAnalysisRecord(analysisId, request.resource.data);
        allow update: if isOwner() && validAnalysisRecord(analysisId, request.resource.data)
                      && createdAtUnchanged()
                      && request.resource.data.athleteId == resource.data.athleteId
                      && request.resource.data.ownerUserId == resource.data.ownerUserId;
      }

      // athletes/lindsay/equipment/main/records/{recordId}: 10 segments (ADR-005 §1, §9).
      // Same idea as analyses/{id}: exact keys, ISO createdAt, lindsay, contract provenance.
      // Pose does not run here; the model block is still required by AnalysisProvenance.
      // Gauge points and rule hints are lists with a size cap only. Unrolling every
      // point and every hint exceeds the rules engine's 1000-expression evaluation cap.
      // exactKeys on the document is what rejects a video field or a missing contract key.
      function validGaugeList(items) {
        return items is list && items.size() <= 21;
      }

      function validHintList(items) {
        return items is list && items.size() <= 96;
      }

      function validEquipmentText(value, max) {
        return value is string && value.size() <= max;
      }

      function validEquipmentHistory(id, d) {
        return validId(id)
          && exactKeys(d, ['id', 'ownerUserId', 'athleteId', 'createdAt', 'updatedAt',
                           'provenance', 'symptomKey', 'symptomText', 'height', 'weight',
                           'bladeLength', 'leftRocker', 'rightRocker', 'offsets', 'bend',
                           'adjustmentType', 'feedbackRating', 'adjustmentNotes',
                           'missingCore', 'ruleHints', 'findings'])
          && d.id == id
          && d.ownerUserId == userId
          && d.athleteId == 'lindsay'
          && validIsoCreatedAt(d.createdAt)
          && validIsoCreatedAt(d.updatedAt)
          && validAnalysisProvenance(d.provenance)
          && d.provenance.algorithmVersion == 'legacy-equipment-port-1'
          && d.symptomKey in ['slide', 'boot-out', 'unstable', 'ankle', 'release', 'asymmetry']
          && validEquipmentText(d.symptomText, 500)
          && validEquipmentText(d.height, 40)
          && validEquipmentText(d.weight, 40)
          && validEquipmentText(d.bladeLength, 40)
          && validGaugeList(d.leftRocker)
          && validGaugeList(d.rightRocker)
          && d.offsets is map
          && exactKeys(d.offsets, ['leftFront', 'leftRear', 'rightFront', 'rightRear'])
          && validEquipmentText(d.offsets.leftFront, 80)
          && validEquipmentText(d.offsets.leftRear, 80)
          && validEquipmentText(d.offsets.rightFront, 80)
          && validEquipmentText(d.offsets.rightRear, 80)
          && d.bend is map
          && exactKeys(d.bend, ['front', 'middle', 'rear'])
          && validEquipmentText(d.bend.front, 40)
          && validEquipmentText(d.bend.middle, 40)
          && validEquipmentText(d.bend.rear, 40)
          && d.adjustmentType in ['unchanged', 'radius-rocker', 'offset', 'bend',
                                  'blade-change', 'boot-change', 'combined']
          && d.feedbackRating in ['not-skated', 'clear-improvement', 'slight-improvement',
                                  'no-change', 'worse-revert']
          && validEquipmentText(d.adjustmentNotes, 500)
          && d.missingCore is bool
          && validHintList(d.ruleHints)
          && d.findings is list
          && d.findings.size() == 1
          && validFinding(d.findings[0], id)
          && d.findings[0].code == 'equipment.symptom.' + d.symptomKey;
      }

      match /athletes/lindsay/equipment/main/records/{recordId} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && validEquipmentHistory(recordId, request.resource.data);
        allow update: if isOwner() && validEquipmentHistory(recordId, request.resource.data)
                      && createdAtUnchanged()
                      && request.resource.data.athleteId == resource.data.athleteId
                      && request.resource.data.ownerUserId == resource.data.ownerUserId;
      }
    }
  }
}
