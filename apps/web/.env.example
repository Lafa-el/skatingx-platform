# Copy to .env.local for local development. Client configuration only: nothing secret here.
# For local development use the Firebase Emulator or the staging project, never production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Race Day Companion (ADR-001 D3). Only the text "true" turns it on; unset means off.
# Vite inlines this at build time: after changing it on Vercel, redeploy.
VITE_FEATURE_RACE_DAY=
