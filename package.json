{
  "name": "skatingx-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @skatingx/web",
    "build": "npm run build -w @skatingx/web",
    "typecheck": "npm run typecheck -w @skatingx/schema && npm run typecheck -w @skatingx/skating-domain && npm run typecheck -w @skatingx/firebase-client && npm run typecheck -w @skatingx/web",
    "lint": "eslint .",
    "test": "vitest",
    "test:rules": "node scripts/test-rules.mjs",
    "test:migration": "node scripts/test-migration.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
