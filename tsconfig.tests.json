{
  "$comment": "Type-checks tests/ plus the analysis M2 contract types. These files sit outside every package tsconfig, so without this they were never type-checked in CI. The contract file is definitions only.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@skatingx/schema": ["packages/schema/src/index.ts"],
      "@skatingx/skating-domain": ["packages/skating-domain/src/index.ts"],
      "@skatingx/firebase-client": ["packages/firebase-client/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "docs/migration/analysis/contract-types.ts"]
}
